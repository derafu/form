{#
   This template renders a horizontal layout.
   It assumes that the 'element' variable is available and contains the UI element object.
   The 'elements_html' variable contains the child elements already rendered, and 'columns' the options of the
   column of each one (the `col_size` that the element asks for and its `elements_options`, that decide first).
#}

{% set layout_attr = options.layout_attr|default({}) %}
{% set layout_class = 'row ' ~ (layout_attr.class|default('')) %}

<div class="{{ layout_class }}"{% for attr_name, attr_value in layout_attr %} {% if attr_name != 'class' %} {{ attr_name }}="{{ attr_value }}"{% endif %}{% endfor %}>
    {% for index, element_html in elements_html %}
        {# The column has the size that was asked for; the ones without it share the space that is left, equally. #}
        {% set column = columns[index]|default({}) %}
        {% set col_class = column.col_size is defined ? 'col-md-' ~ column.col_size : 'col-md' %}

        {# Apply additional classes if specified. #}
        {% if column.class is defined %}
            {% set col_class = col_class ~ ' ' ~ column.class %}
        {% endif %}

        <div class="{{ col_class }}">
            {{ element_html|raw }}
        </div>
    {% endfor %}
</div>
